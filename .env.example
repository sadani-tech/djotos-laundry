# Salin ke .env lalu sesuaikan. Dipakai docker-compose.
POSTGRES_USER=djotos
POSTGRES_PASSWORD=djotos_secret
POSTGRES_DB=djotos
JWT_SECRET=ganti-dengan-string-acak-panjang
# Provider WA: mock | fonnte | wablas | cloud
WA_PROVIDER=mock
FONNTE_TOKEN=
WABLAS_BASE_URL=https://solo.wablas.com
WABLAS_TOKEN=
WABLAS_SECRET=
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
# Seeder akun owner
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=owner123
# URL API yang dipakai browser (frontend)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
