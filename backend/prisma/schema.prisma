// Skema database Djotos Laundry. Uang disimpan sebagai Int (rupiah), berat sebagai Float (kg).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STAFF
}

enum OrderStatus {
  RECEIVED   // Diterima
  WASHING    // Cuci
  IRONING    // Setrika
  FINISHED   // Selesai
  PICKED_UP  // Diambil
  CANCELLED  // Dibatalkan
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PayMethod {
  CASH
  QRIS
}

enum ServiceCategory {
  REGULER
  EXPRESS
  SATUAN
}

enum Unit {
  KG
  PCS
}

// Jenis pekerjaan sebuah layanan, untuk memisahkan kg cuci / setrika di performa staff.
enum WorkType {
  WASH // cuci saja (CB, CBX)
  IRON // setrika saja (ST, STX)
  WASH_IRON // cuci + setrika sekaligus (CK, CKX)
  OTHER // satuan / lainnya
}

enum BonusType {
  PER_KG
  PERCENT_OMZET
}

enum BonusStatus {
  DRAFT
  PAID
}

enum WaStatus {
  QUEUED
  SENT
  FAILED
}

enum WaType {
  FINISHED
  FREE_READY
  MANUAL
  TEST
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  name         String
  passwordHash String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       Order[]
  payments     Payment[]
  expenses     Expense[]
  freeClaims   FreeClaim[]
  bonusRecords BonusRecord[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String?   @unique // format 62xxxxxxxxxx
  address   String?
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  orders     Order[]
  freeClaims FreeClaim[]
  waLogs     WaLog[]

  @@index([name])
  @@map("customers")
}

model Service {
  id             Int             @id @default(autoincrement())
  code           String          @unique // CK, CB, ST, CKX, ... SPK, BDJ
  name           String
  category       ServiceCategory
  unit           Unit            @default(KG)
  rate           Int // tarif per kg / per pcs
  minQty         Float           @default(1) // minimum yang ditagih
  minPrice       Int? // harga minimum (mis. CK 3 kg = 16.000)
  workType       WorkType        @default(OTHER)
  countsForFree  Boolean         @default(false)
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  items OrderItem[]

  @@map("services")
}

model Order {
  id            Int           @id @default(autoincrement())
  invoiceNo     String        @unique
  customerId    Int
  staffId       Int
  status        OrderStatus   @default(RECEIVED)
  subtotal      Int
  discount      Int           @default(0)
  total         Int
  paidAmount    Int           @default(0)
  paymentStatus PaymentStatus @default(UNPAID)
  isFree        Boolean       @default(false) // nota hasil klaim FREE
  countsForFree Boolean       @default(false) // mengandung layanan yang dihitung FREE
  freeClaimId   Int? // klaim yang "memakai" nota ini
  note          String?
  receivedAt    DateTime      @default(now())
  finishedAt    DateTime?
  pickedUpAt    DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  customer  Customer    @relation(fields: [customerId], references: [id])
  staff     User        @relation(fields: [staffId], references: [id])
  items     OrderItem[]
  payments  Payment[]
  waLogs    WaLog[]
  consumedBy FreeClaim? @relation("ClaimConsumes", fields: [freeClaimId], references: [id])
  claimOrder FreeClaim? @relation("ClaimOrder")

  @@index([customerId])
  @@index([staffId, creat